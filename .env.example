# Server port for the web UI
PORT=3200

# Steam Web API key — OPTIONAL. Not needed for Moose (searched by SteamID64
# directly). Only required if a future provider must search by Steam name.
# Get one free at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Run the scraping browser headless (true) or visible (false, useful for debugging)
HEADLESS=true
