# Server port for the web UI
PORT=3200

# Steam Web API key — OPTIONAL. Not needed for Moose (searched by SteamID64
# directly). Only required if a future provider must search by Steam name.
# Get one free at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Run the scraping browser headless (true) or visible (false, useful for debugging)
HEADLESS=true

# How long to cache the provider's server/tab/week lists (they rarely change).
FILTERS_CACHE_TTL_HOURS=24

# How many parallel browser contexts scrape/snapshot shard players across. Higher
# = faster snapshots but more CPU/RAM (each context is a Chrome window). Lower it
# on a small box like a Raspberry Pi (e.g. 2) if snapshots crash or thrash.
SCRAPER_CONCURRENCY=4
